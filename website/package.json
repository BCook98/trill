{
  "name": "trill-website",
  "version": "0.0.0",
  "private": true,
  "description": "Local development tools for the static Trill website",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preview": "http-server . -a 127.0.0.1 -p 8780 -c-1",
    "check": "node --check site.js && node --check ../tests/website_demo.cjs",
    "browsers:install": "playwright install --no-shell chromium webkit",
    "test": "NODE_PATH=./node_modules node ../tests/website_demo.cjs"
  },
  "devDependencies": {
    "http-server": "14.1.1",
    "playwright": "1.64.1"
  }
}
